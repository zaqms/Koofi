# Names must match lib/env.ts and README. None required for web chat.
# Optional public origin for WhatsApp card links only.
# Leave empty for local web chat. Do not invent a production domain.
KOOFI_PUBLIC_URL=

# WhatsApp Cloud API — not required to run the web chat.
# Attach a Meta / WhatsApp number later. See README.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
