# Names must match lib/env.ts and README. None required for web chat.
# Optional public origin for WhatsApp card links only.
# Leave empty for local web chat. Do not invent a production domain.
KOOFI_PUBLIC_URL=

# WhatsApp Cloud API — not required to run the web chat.
# Attach a Meta / WhatsApp number later. See README.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional live Place Details (rating + one snippet) for real shops.
# If empty, pick cards hide the rating row and keep the letter mark.
# Do not scrape Maps. Not used to rank picks.
GOOGLE_PLACES_API_KEY=

# Optional. If set, shop suggestions open a GitHub issue on zaqms/Koofi.
# Not required. Chat still thanks them if this is empty.
GITHUB_TOKEN=
