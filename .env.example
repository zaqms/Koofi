# Names must match lib/env.ts and README. None required for web chat.
# Optional public origin for WhatsApp card links only.
# Leave empty for local web chat. Do not invent a production domain.
KOOFI_PUBLIC_URL=

# WhatsApp Cloud API — not required to run the web chat.
# Attach a Meta / WhatsApp number later. See README.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional. Cloud API Authentication template name for owner-claim OTP.
# Default: wain_claim_otp. Never WhatsApp Web / QR.
WHATSAPP_OTP_TEMPLATE=
# Optional. If 1 or true, owner-claim OTP stays on stub 000000 even when
# WhatsApp tokens exist. Default off.
CLAIM_OTP_DEV_STUB=

# Optional live Place Details (rating + one snippet) for real shops.
# If empty, pick cards hide the rating row and keep the letter mark.
# Do not scrape Maps. Not used to rank picks.
GOOGLE_PLACES_API_KEY=

# Optional. If set, shop suggestions open a GitHub issue on zaqms/Koofi.
# Not required. Chat still thanks them if this is empty.
GITHUB_TOKEN=

# Optional. Spoken line above the three cards via xAI chat completions.
# If empty or the call fails, Koofi uses copy.threePicks / fewerPicks.
# Cards still send. Never commit a real key.
XAI_API_KEY=

# Optional. Bearer token for GET /api/learn (private pile, not linked in the UI).
# If empty, that read returns 404. Chat still works. Never commit a real token.
LEARNING_READ_TOKEN=

# Optional. Neon / Vercel Postgres for the public /feedback board,
# directory-list shop upvotes, and owner claims. Required on Vercel
# (Production + Preview) for those to persist. Chat and the catalog
# still work if this is empty. Local `next dev` can run them in memory
# when this is unset.
DATABASE_URL=

# Optional. Where to email a pending owner-claim alert. Defaults to
# aj@cali.sa in code if empty. Sending also needs RESEND_API_KEY.
# If both are empty, the submit still logs `wain_claim` for Ajz.
CLAIM_ALERT_TO=

# Optional. If set, claim submit emails CLAIM_ALERT_TO via Resend.
# Never commit a real key. Without it, email is stubbed and logged.
RESEND_API_KEY=
